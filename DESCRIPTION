Package: scClustEval
Type: Package
Title: Single Cell Clustering Evaluation and Optimization Framework
Version: 1.0.0
Date: 2026-01-26
Authors@R: c(
    person("Zaoqu", "Liu", 
           email = "liuzaoqu@163.com", 
           role = c("aut", "cre"),
